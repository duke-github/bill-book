.page {
  height: 100vh;
  background: #fff;
  overflow: hidden;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 152rpx;
  padding: 70rpx 32rpx 0;
  background: #87E8DE;
}

.cancel,
.placeholder {
  width: 96rpx;
  height: 56rpx;
  color: #111827;
  font-size: 28rpx;
  line-height: 56rpx;
  text-align: left;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
}

.type-tabs {
  display: flex;
  justify-content: center;
  gap: 42rpx;
  height: 94rpx;
  padding-top: 22rpx;
  background: #87E8DE;
  border-radius: 0 0 28rpx 28rpx;
}

.type-tab {
  position: relative;
  width: 110rpx;
  height: 56rpx;
  color: #8a8f98;
  font-size: 32rpx;
  line-height: 56rpx;
  text-align: center;
}

.type-tab.active {
  color: #111827;
  font-weight: 700;
}

.content {
  height: calc(100vh - 152rpx - 94rpx - 192rpx - 366rpx);
  background: #fff;
  overflow: hidden;
}

.content.system-content {
  height: calc(100vh - 152rpx - 94rpx - 192rpx);
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 28rpx 12rpx;
  padding: 34rpx 24rpx 22rpx;
}

.category {
  display: flex;
  align-items: center;
  flex-direction: column;
}

.category-icon {
  width: 86rpx;
  height: 86rpx;
  border-radius: 50%;
  background: #f1f2f4;
  color: #626873;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 86rpx;
  text-align: center;
}

.category.active .category-icon {
  background: #87E8DE;
  color: #111827;
}

.category-name {
  width: 130rpx;
  margin-top: 14rpx;
  color: #111827;
  font-size: 24rpx;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.entry-panel {
  position: fixed;
  right: 0;
  bottom: calc(366rpx + env(safe-area-inset-bottom));
  left: 0;
  z-index: 15;
  background: #fff;
}

.system-entry-panel {
  bottom: 0;
}

.amount-date-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 104rpx;
  padding: 0 34rpx;
  border-top: 1rpx solid #f0f1f3;
  border-bottom: 1rpx solid #f0f1f3;
  background: #fff;
}

.amount {
  max-width: 360rpx;
  font-size: 48rpx;
  font-weight: 500;
  overflow: hidden;
  text-align: left;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.amount-input {
  width: 360rpx;
  height: 104rpx;
  line-height: 104rpx;
}

.date-picker {
  flex: 1;
  text-align: right;
}

.form {
  padding: 0 34rpx;
  background: #fff;
}

.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  border-top: 1rpx solid #f0f1f3;
}

.form-label {
  color: #6b7280;
  font-size: 28rpx;
}

.form-value {
  color: #111827;
  font-size: 28rpx;
}

.remark-row {
  height: 88rpx;
  border-top: 1rpx solid #f0f1f3;
}

.remark {
  width: 100%;
  height: 88rpx;
  font-size: 28rpx;
}

.placeholder-text {
  color: #9ca3af;
}

.save-btn {
  box-sizing: border-box;
  width: 100%;
  height: 84rpx;
  margin-top: 24rpx;
  border-radius: 8rpx;
  background: #87E8DE;
  color: #111827;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 84rpx;
}

.keyboard {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  height: 366rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
  border-top: 1rpx solid #e5e7eb;
}

.key {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  margin: 0;
  padding: 0;
  border-right: 1rpx solid #e5e7eb;
  border-bottom: 1rpx solid #e5e7eb;
  border-radius: 0;
  background: #fff;
  color: #111827;
  font-size: 34rpx;
  text-align: center;
}

.key.action {
  font-size: 28rpx;
}

.key.done {
  background: #87E8DE;
  font-size: 30rpx;
  font-weight: 700;
}
