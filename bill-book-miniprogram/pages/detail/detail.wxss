.page {
  height: 100vh;
  background: #fff;
  overflow: hidden;
}

.hero {
  height: 280rpx;
  padding: 52rpx 32rpx 24rpx;
  border-bottom: 1rpx solid rgba(17, 24, 39, 0.08);
}

.top-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 56rpx;
}

.month-switch {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
}

.switch-btn {
  width: 44rpx;
  height: 44rpx;
  padding: 0;
  color: #111827;
  font-size: 42rpx;
  line-height: 40rpx;
  text-align: center;
}

.month-label {
  display: block;
  min-width: 150rpx;
  color: #111827;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 44rpx;
  text-align: center;
  white-space: nowrap;
}

.summary {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 30rpx;
  padding: 0 24rpx;
}

.summary-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 12rpx;
  transition: background 0.2s;
}

.summary-item.active {
  background: rgba(255, 255, 255, 0.45);
}

.label {
  display: block;
  color: #2f7565;
  font-size: 24rpx;
}

.value {
  display: block;
  margin-top: 8rpx;
  font-size: 40rpx;
  font-weight: 700;
}

.divider {
  width: 1rpx;
  height: 52rpx;
  background: rgba(17, 24, 39, 0.25);
}

.list {
  height: calc(100vh - 280rpx - 164rpx);
  background: #fff;
  border-bottom: 4rpx solid #f5f6f8;
}

.day-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 58rpx;
  padding: 0 32rpx;
  color: #8a8f98;
  font-size: 24rpx;
  border-bottom: 1rpx solid #edf0f2;
}

.day-summary {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.record-list {
  padding-left: 32rpx;
}

.record {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  padding-right: 32rpx;
  border-bottom: 1rpx solid #edf0f2;
}

.icon {
  width: 58rpx;
  height: 58rpx;
  margin-right: 26rpx;
  border-radius: 50%;
  background: #f1f2f4;
  color: #111827;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 58rpx;
  text-align: center;
}

.record-main {
  flex: 1;
  min-width: 0;
}

.record-title {
  font-size: 34rpx;
  font-weight: 400;
}

.record-remark {
  margin-top: 8rpx;
  color: #8a8f98;
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-side {
  display: flex;
  align-items: flex-end;
  flex-direction: column;
  margin-left: 20rpx;
}

.amount {
  color: #111827;
  font-size: 34rpx;
  font-weight: 400;
}

.amount.income {
  color: #0f9f6e;
}

.empty-hint {
  padding: 80rpx 0;
  color: #9ca3af;
  font-size: 28rpx;
  text-align: center;
}

.list-footer {
  padding: 24rpx 0;
  color: #c0c4cc;
  font-size: 24rpx;
  text-align: center;
}

.bottom-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  height: 136rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
}

.tab-group {
  flex: 1;
  display: flex;
  align-items: center;
}

.left-group {
  justify-content: space-evenly;
}

.right-group {
  justify-content: space-evenly;
}

.nav-item {
  width: 108rpx;
  color: #6b7280;
  font-size: 22rpx;
  line-height: 30rpx;
  text-align: center;
}

.nav-item.active {
  color: #111827;
}

.nav-icon {
  width: 42rpx;
  height: 42rpx;
  margin: 0 auto 8rpx;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.add-item {
  width: 150rpx;
  color: #111827;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 30rpx;
  text-align: center;
  padding-bottom: 12rpx;
}

.add-btn {
  box-sizing: border-box;
  width: 96rpx;
  height: 96rpx;
  margin: -56rpx auto 8rpx;
  padding: 0;
  border: 6rpx solid #fff;
  border-radius: 50%;
  color: #111827;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 70rpx;
  font-weight: 400;
  line-height: 74rpx;
  box-shadow: 0 4rpx 16rpx rgba(17, 24, 39, 0.18);
}

.editor {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  background: #fff;
}

.editor-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 152rpx;
  padding: 70rpx 32rpx 0;
}

.editor-tabs {
  display: flex;
  justify-content: center;
  gap: 42rpx;
  height: 94rpx;
  padding-top: 22rpx;
  border-radius: 0 0 28rpx 28rpx;
}

.editor-tab {
  width: 110rpx;
  height: 56rpx;
  color: #8a8f98;
  font-size: 32rpx;
  line-height: 56rpx;
  text-align: center;
}

.editor-tab.active {
  color: #111827;
  font-weight: 700;
}

.editor-content {
  height: auto;
  overflow: hidden;
  background: #fff;
}

.editor-category-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 28rpx 12rpx;
  padding: 34rpx 24rpx 22rpx;
}

.editor-category {
  display: flex;
  align-items: center;
  flex-direction: column;
}

.editor-category-icon {
  width: 86rpx;
  height: 86rpx;
  border-radius: 50%;
  background: #f1f2f4;
  color: #626873;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 86rpx;
  text-align: center;
}

.editor-category.active .editor-category-icon {
  color: #111827;
}

.editor-category-name {
  width: 130rpx;
  margin-top: 14rpx;
  color: #111827;
  font-size: 24rpx;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.editor-entry {
  position: relative;
  z-index: 105;
  background: #fff;
}

.editor-amount-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 104rpx;
  padding: 0 34rpx;
  border-top: 1rpx solid #f0f1f3;
  border-bottom: 1rpx solid #f0f1f3;
}

.editor-amount {
  max-width: 360rpx;
  color: #111827;
  font-size: 48rpx;
  font-weight: 500;
  overflow: hidden;
  text-align: left;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.editor-date-picker {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  width: 330rpx;
  height: 104rpx;
  text-align: right;
}

.editor-date {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  width: 100%;
  height: 100%;
  color: #111827;
  font-size: 28rpx;
}

.editor-remark-row {
  height: 88rpx;
  padding: 0 34rpx;
  border-bottom: 1rpx solid #f0f1f3;
}

.editor-remark {
  width: 100%;
  height: 88rpx;
  font-size: 28rpx;
}

.placeholder-text {
  color: #9ca3af;
}

.editor-keyboard {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 105;
  box-sizing: border-box;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  height: 366rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
  border-top: 1rpx solid #e5e7eb;
}

.editor-key {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-right: 1rpx solid #e5e7eb;
  border-bottom: 1rpx solid #e5e7eb;
  color: #111827;
  font-size: 34rpx;
  text-align: center;
}

.editor-key.action {
  font-size: 28rpx;
}

.editor-key.done {
  font-size: 30rpx;
  font-weight: 700;
}
