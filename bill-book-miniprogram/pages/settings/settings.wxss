.settings-page {
  height: 100vh;
  overflow: hidden;
  background: #f7f7f7;
}

.settings-header {
  padding: 88rpx 32rpx 28rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #111827;
  text-align: center;
}

.settings-body {
  height: calc(100vh - 180rpx - 136rpx);
  padding: 0 32rpx 32rpx;
}

.section {
  margin-top: 28rpx;
  padding: 28rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 24rpx;
}

.color-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.color-option {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  transition: transform 0.15s;
}

.color-option.active {
  transform: scale(1.1);
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.2);
}

.check-mark {
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.color-label {
  position: absolute;
  bottom: -36rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 20rpx;
  color: #6b7280;
  white-space: nowrap;
}

.budget-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.budget-date {
  padding: 16rpx 20rpx;
  background: #f3f4f6;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #111827;
  white-space: nowrap;
}

.budget-input {
  flex: 1;
  height: 64rpx;
  padding: 0 20rpx;
  background: #f3f4f6;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #111827;
}

.save-budget-btn {
  padding: 16rpx 28rpx;
  background: #111827;
  color: #fff;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 500;
  white-space: nowrap;
}

.bottom-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-evenly;
  height: 136rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
}

.nav-item {
  width: 108rpx;
  color: #6b7280;
  font-size: 22rpx;
  line-height: 30rpx;
  text-align: center;
}

.nav-item.active {
  color: #111827;
}

.nav-icon {
  width: 42rpx;
  height: 42rpx;
  margin: 0 auto 8rpx;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.add-btn {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin: -56rpx auto 12rpx;
  padding: 0;
  border: 6rpx solid #fff;
  border-radius: 50%;
  color: #111827;
  font-size: 70rpx;
  font-weight: 400;
  line-height: 74rpx;
  box-shadow: 0 4rpx 16rpx rgba(17, 24, 39, 0.18);
}

.add-item {
  color: #111827;
  font-weight: 500;
}
